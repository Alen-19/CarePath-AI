# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/carepath_db?retryWrites=true&w=majority

# Authentication & Security
JWT_SECRET=carepath_ai_super_secret_jwt_key_2026

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Razorpay Teleconsultation Gateway
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Delivery (Gmail App Password)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_16_digit_app_password

# Google Gemini Vision / AI
GEMINI_API_KEY=your_gemini_api_key

# Edamam Nutrition & Recipe APIs (https://developer.edamam.com/)
# 1. Recipe Search API (For dynamic Breakfast/Lunch/Dinner generation)
EDAMAM_APP_ID=your_edamam_recipe_app_id
EDAMAM_APP_KEY=your_edamam_recipe_app_key

# 2. Food Database Parser API (For Meal photo recognition & macro lookup)
EDAMAM_FOOD_APP_ID=your_edamam_food_parser_app_id
EDAMAM_FOOD_APP_KEY=your_edamam_food_parser_app_key
